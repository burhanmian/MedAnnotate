{
  "name": "medannotate-studio",
  "version": "1.4.0",
  "private": true,
  "description": "MedAnnotate by Mian Burhan Aftab: medical image sorting, annotation and dataset preparation",
  "author": "Mian Burhan Aftab",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "desktop:build": "electron-builder --publish never",
    "serve": "node serve.cjs",
    "ai:gateway": "node ai/gateway.cjs",
    "sort": "node scripts/sort.cjs"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "org.medannotate.studio",
    "productName": "MedAnnotate",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "ai/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.medical"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "extraResources": [
      {
        "from": "ai/medsam_server.py",
        "to": "ai/medsam_server.py"
      }
    ]
  }
}
